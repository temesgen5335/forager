[Unit]
Description=Frequent job ingestion (interval from .env INGEST_EVERY_HOURS)

[Timer]
# OnCalendar + jitter are filled from .env (INGEST_EVERY_HOURS, INGEST_JITTER_SEC)
# by scripts/install_services.sh — edit .env and re-run the installer to change them.
OnCalendar=__INGEST_ONCALENDAR__
Persistent=true
RandomizedDelaySec=__INGEST_JITTER__

[Install]
WantedBy=timers.target
