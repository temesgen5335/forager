[Unit]
Description=Daily job digest (time from .env DIGEST_AT)

[Timer]
# OnCalendar is filled from .env (DIGEST_AT) by scripts/install_services.sh — edit .env
# and re-run the installer to change it. Set the server TZ first so this means your local
# time: sudo timedatectl set-timezone <Region>/<City>   (e.g. Europe/Berlin)
OnCalendar=__DIGEST_ONCALENDAR__
Persistent=true

[Install]
WantedBy=timers.target
