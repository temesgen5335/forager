# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# All settings are read by src/jobagent/config.py via pydantic-settings.

# --- LLM: multi-provider with automatic failover ---
# Set any subset of keys. The chain tries the primary first, then falls through to
# the next provider that has a key on any error / rate-limit / quota exhaustion.
LLM_PROVIDER=groq                  # primary: groq | gemini | openrouter | openai | anthropic
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=
# Cerebras — ~1M tokens/day free, fastest inference available. OpenAI-compatible.
CEREBRAS_API_KEY=
# GitHub Models — free with a GitHub account. This is a PAT with the `models:read`
# scope, NOT a vendor API key. Fronts OpenAI/Meta/Mistral models.
GITHUB_MODELS_TOKEN=                       # DashScope (Alibaba); Qwen is also on OpenRouter
# Per-provider model overrides (free-friendly defaults shown):
GROQ_MODEL=llama-3.3-70b-versatile   # free; 8b-instant is slightly faster but cannot run tool loops
OPENROUTER_MODEL=minimax/minimax-m3:free   # fallback only when FANOUT can't fetch the live list
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
QWEN_MODEL=
CEREBRAS_MODEL=llama-3.3-70b
GITHUB_MODELS_MODEL=openai/gpt-4o-miniqwen-plus
# More OpenAI-compatible providers with free/generous tiers — add a key and they join
# the failover chain automatically (order in llm_client._DEFAULT_ORDER, free-first).
SAMBANOVA_API_KEY=                  # fast Llama inference, free tier
NVIDIA_API_KEY=                     # NVIDIA NIM (integrate.api.nvidia.com)
MISTRAL_API_KEY=                    # Mistral La Plateforme
LLAMA_API_KEY=                      # Meta Llama API (api.llama.com/compat/v1)
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
MISTRAL_MODEL=mistral-small-latest
LLAMA_MODEL=Llama-3.3-70B-Instruct
# OpenRouter free-model fan-out: try ALL currently-free :free chat models as backups,
# fetched live so a withdrawn slug is skipped for the next one (recommended — the old
# single OPENROUTER_MODEL slug 404'd once it lost its free tier).
OPENROUTER_FREE_FANOUT=true         # recommended; set false to pin the single OPENROUTER_MODEL
OPENROUTER_FREE_MAX=6               # cap how many free models join the chain
# Pollinations (text.pollinations.ai) needs NO API key. Opt-in so a no-key install still
# reports "no LLM configured" rather than silently routing through a third party.
POLLINATIONS_ENABLED=false
POLLINATIONS_MODEL=openai

# Custom OpenAI-compatible endpoint (Ollama / vLLM / any local or hosted server):
CUSTOM_LLM_BASE_URL=                # e.g. http://localhost:11434/v1  (set LLM_PROVIDER=custom to prefer it)
CUSTOM_LLM_API_KEY=                 # blank is fine for local servers
CUSTOM_LLM_MODEL=                   # e.g. llama3.1

# --- Dashboard config UI (v2.1) ---
DASHBOARD_PASSWORD=                 # set to enable editing config from the dashboard (gates /config)
JOBAGENT_MASTER_KEY=                # Fernet key for the encrypted secret store: python scripts/genkey.py

# --- Telegram: TWO distinct credentials, two distinct roles ---
# 1) Telethon (MTProto) — reads job-posting CHANNELS as your user account.
#    Get api_id / api_hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=                                     # for first-run login
TELEGRAM_CHANNELS=                                  # comma-separated, e.g. @remote_jobs,@ai_jobs
TELEGRAM_SESSION=data/telegram                      # Telethon .session file path (gitignored)
TELEGRAM_FETCH_LIMIT=50                             # messages pulled per channel per run
# 2) Bot API — the bot you TALK TO. Get token from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                                   # where the bot DMs you; = your user id for a personal bot
TELEGRAM_OWNER_ID=                                  # optional alias/fallback for the owner gate

# --- ATS boards to watch (comma-separated company slugs) ---
GREENHOUSE_SLUGS=                                   # e.g. stripe,airbnb
LEVER_SLUGS=                                        # e.g. netflix
ASHBY_SLUGS=                                        # e.g. ramp

# --- Job source: aggregator for Indeed / LinkedIn / Glassdoor / JobRight ---
SERPAPI_KEY=                                        # serpapi.com Google Jobs engine
JSEARCH_API_KEY=                                    # RapidAPI key → LinkedIn/Indeed/Glassdoor
JSEARCH_LOCATION=                                   # blank = use the profile's location
APIFY_TOKEN=                                        # optional secondary aggregator

# --- Store ---
JOBAGENT_DB_PATH=data/jobagent.db                   # sqlite for v1; swap to postgres URL later
# Your profile/preferences and CV live in these gitignored files, edited via Settings.
# Defaults are fine; override only to relocate them. Never commit real identity (R22).
JOBAGENT_PROFILE_PATH=data/profile.json
JOBAGENT_CV_PATH=data/cv_master.md

# --- Email sending (Tier 1 apply) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APPLY_FROM_EMAIL=

# --- Application review (optional; the ATS-parseability report is always on) ---
# A second agent critiques the tailored CV/cover letter and the drafter revises it.
# It REWRITES generated content, so it ships OFF — turn it on only after a live-model
# check that the revise prompt still honors R1 (no fabrication). See R1b.
APPLY_REVIEW_ENABLED=false
APPLY_REVIEW_ROUNDS=1
# Render the tailored CV to a PDF and attach THAT (so the ATS report checks the exact
# bytes sent), instead of the static CV at your profile's cv_path. Needs the `apply`
# extra (fpdf2). Off by default — an auto-rendered CV is plainer than a hand-designed one.
APPLY_RENDER_CV_PDF=false

# --- Inbox outcome detection (optional) ---
# Reads the mailbox you apply FROM and PROPOSES status changes for one-tap confirmation.
# It never applies one. Usually the same account as SMTP above.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- API security (Tier 1) ---
# Comma-separated browser origins allowed to call the API. Defaults to the local
# dashboard only; add your deployed dashboard origin here. Never "*" in production —
# write routes can send email as you.
JOBAGENT_CORS_ORIGINS=http://localhost:1234,http://127.0.0.1:1234

# Gate GET routes too. Off by default, which is correct on the 127.0.0.1 bind: the
# dashboard renders reads server-side with no token to offer. Turn it ON for any
# deployment the network can reach — /applications and /followups reveal where you
# applied and what was rejected. The dashboard then needs JOBAGENT_API_TOKEN
# (get it from `python scripts/api_token.py`). See SECURITY.md.
JOBAGENT_REQUIRE_AUTH_READS=false
# Only the DASHBOARD needs this, and only when the above is true.
JOBAGENT_API_TOKEN=

# Requests per hour per client, per class. Generous by design — these stop a runaway
# loop or an exposed port draining an LLM quota, not normal use. 0 disables a class.
JOBAGENT_RATE_LIMIT_ENABLED=true
JOBAGENT_RATE_LIMIT_ASSISTANT=60
JOBAGENT_RATE_LIMIT_INGEST=20
JOBAGENT_RATE_LIMIT_WRITE=600

# --- Dashboard → API addressing ---
# JOBAGENT_API_URL is what the dashboard SERVER calls (SSR, may be 127.0.0.1).
# PUBLIC_JOBAGENT_API_URL is what the visitor's BROWSER calls — set this whenever the
# dashboard and API are not on the same machine (e.g. dashboard on Vercel, API on a VPS).
JOBAGENT_API_URL=http://127.0.0.1:8077
PUBLIC_JOBAGENT_API_URL=

# --- Scheduling (VPS / systemd timers) ---
# How often the autonomous timers fire. scripts/install_services.sh reads these when it
# renders the systemd units, so edit them and re-run the installer to change the cadence
# — no need to hand-write systemd calendar syntax. Unset falls back to the defaults shown.
# (The free-tier GitHub Actions digest keeps its own cron in .github/workflows/digest.yml,
# because GitHub requires a literal there.)
INGEST_EVERY_HOURS=4        # ingest+match cadence, 1-24 (a divisor of 24 gives even spacing)
DIGEST_AT=07:00             # daily digest time, HH:MM, server-local (set the server timezone)
INGEST_JITTER_SEC=300       # random delay added to each ingest run, in seconds
