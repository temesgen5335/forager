---
// Overview (design: Job Agent.dc.html). Health first — a degraded pipeline must be
// the first thing on screen, not a footnote — then the morning numbers, then the
// funnel and the 30-day rhythm. Every figure traces to a real API field.
import Layout from "../layouts/Layout.astro";
import { getStats, getAnalytics, apiBase, publicApiBase, type Stats, type Analytics } from "../lib/api";

let stats: Stats | null = null;
let analytics: Analytics | null = null;
let error: string | null = null;
try {
  stats = await getStats();
  analytics = await getAnalytics();
} catch (e) {
  error = (e as Error).message;
}

const hour = new Date().getHours();
const greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
const today = new Date().toLocaleDateString(undefined, { weekday: "long", day: "numeric", month: "long" });

const health = stats?.health ?? null;
const sources = health?.sources ?? [];
const staleSources = sources.filter((s) => (s.hours_since ?? Infinity) > 48);
const degraded = !!health && (health.is_stale || health.recent_errors > 0 || staleSources.length > 0);

const newLastRun = sources.reduce((n, s) => n + (s.new ?? 0), 0);
const overnightLine = stats
  ? `${newLastRun} new in the last run · ${stats.queue} worth your time`
  : "";

let healthTitle = "Pipeline healthy";
let healthBody = `All ${sources.length || "—"} senses answered on the last run.`;
if (health?.is_stale) {
  healthTitle = "Pipeline looks stale";
  healthBody = health.last_ingest
    ? `Last successful ingestion was ${Math.round(health.hours_since_ingest ?? 0)}h ago (threshold ${health.stale_after_hours}h). Hit “Pull Jobs” above, or check the ingest timer.`
    : "No ingestion has ever completed on this store.";
} else if (staleSources.length > 0) {
  healthTitle = `${staleSources.map((s) => s.source).join(", ")} ${staleSources.length === 1 ? "has" : "have"} gone quiet`;
  healthBody = `No data for 48h+ from ${staleSources.length === 1 ? "this sense" : "these senses"} — the usual cause is an expired credential or a changed board API. Everything below is missing ${staleSources.length === 1 ? "it" : "them"}, including your match counts.`;
} else if ((health?.recent_errors ?? 0) > 0 && health?.last_error) {
  healthTitle = `${health.recent_errors} error(s) in the last 24h`;
  healthBody = `Most recent — ${health.last_error.source ?? "unknown"}: ${health.last_error.error ?? ""}`;
}

const fmtAgo = (h: number | null) =>
  h === null ? "never" : h < 1 ? "<1h ago" : h < 24 ? `${Math.round(h)}h ago` : `${Math.floor(h / 24)}d ago`;
const lastIngestLine = health?.last_ingest
  ? `${new Date(health.last_ingest).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })} · ${fmtAgo(health.hours_since_ingest)}`
  : "never";

const bySourceTotals = new Map((stats?.bySource ?? []).map((s) => [s.source, s.n]));

// The browser-facing base — this button fetches from the visitor's browser, not the
// SSR server, so it must not use the server-side 127.0.0.1.
const publicUrl = publicApiBase();

// Applications by status — full lifecycle order, zero-filled so the shape is stable.
const STATUS_ORDER = ["matched", "drafting", "awaiting_approval", "submitted", "rejected", "interview", "offer", "skipped", "failed"];
const STATUS_COLOR: Record<string, string> = {
  matched: "#737373", drafting: "#60a5fa", awaiting_approval: "#fbbf24",
  submitted: "#7dd3fc", rejected: "#f87171", interview: "#4ade80",
  offer: "#4ade80", skipped: "#585858", failed: "#f87171",
};
const appCounts = new Map((stats?.apps ?? []).map((a) => [a.status, a.n]));
const statusRows = STATUS_ORDER.map((label) => ({ label, count: appCounts.get(label) ?? 0 }));
const maxStatus = Math.max(1, ...statusRows.map((r) => r.count));
const submitted = (appCounts.get("submitted") ?? 0) + (appCounts.get("interview") ?? 0) + (appCounts.get("offer") ?? 0) + (appCounts.get("rejected") ?? 0);

// 30-day series from the analytics timeline (sparse day buckets → dense 30 days).
const byDay = new Map((analytics?.timeline ?? []).map((t) => [t.day, t.n]));
const days: { label: string; n: number }[] = [];
for (let i = 29; i >= 0; i--) {
  const d = new Date(Date.now() - i * 86400000);
  const key = d.toISOString().slice(0, 10);
  days.push({ label: d.toLocaleDateString(undefined, { day: "numeric", month: "short" }), n: byDay.get(key) ?? 0 });
}
const maxDaily = Math.max(1, ...days.map((d) => d.n));
const monthTotal = days.reduce((n, d) => n + d.n, 0);
const pct = (r: number | undefined) => `${Math.round((r ?? 0) * 100)}%`;
---

<Layout title="Overview">
  {error && (
    <div class="down">
      <div class="down-mark">!</div>
      <div class="down-title">Can’t reach the agent</div>
      <p class="down-body">
        The API at <span class="mono">{apiBase()}</span> didn’t respond — nothing on
        this page is live. Start it with <span class="mono">make run_backend</span>.
      </p>
      <button class="btn primary" onclick="location.reload()">Retry</button>
    </div>
  )}

  {stats && (
    <>
      <div class="page-head">
        <div>
          <h1 class="page">{greeting}</h1>
          <div class="page-sub">{today} · {overnightLine}</div>
        </div>
        <div class="fetch-box">
          <button type="button" class="btn primary" id="fetch-now" style="white-space:nowrap">
            Pull Jobs
          </button>
          <div class="mono fetch-status" id="fetch-status" hidden></div>
        </div>
      </div>

      <section class:list={["panel", "health", degraded && "degraded"]}>
        <div class="health-top">
          <div class="health-lead">
            <span class:list={["big-dot", degraded && "bad"]}></span>
            <div>
              <div class:list={["health-title", degraded && "bad"]}>{healthTitle}</div>
              <div class="page-sub" style="margin-top:2px">{healthBody}</div>
            </div>
          </div>
          <div class="health-nums">
            <div>
              <div class="k" style="margin-bottom:3px">Last ingestion</div>
              <div class="mono" style="font-size:13px">{lastIngestLine}</div>
            </div>
            <div>
              <div class="k" style="margin-bottom:3px">Errors 24h</div>
              <div class="mono" style={`font-size:13px;color:${(health?.recent_errors ?? 0) > 0 ? "var(--danger)" : "var(--muted)"}`}>
                {health?.recent_errors ?? 0}
              </div>
            </div>
          </div>
        </div>
        {sources.length > 0 && (
          <div class="src-grid">
            {sources.map((s) => {
              const stale = (s.hours_since ?? Infinity) > 48;
              return (
                <div class="src-cell">
                  <div style="display:flex;align-items:center;gap:6px">
                    <span class:list={["src-dot", stale && "bad"]}></span>
                    <span style="font-size:12.5px">{s.source}</span>
                  </div>
                  <div class="mono src-meta">
                    <span style={stale ? "color:var(--danger)" : ""}>{fmtAgo(s.hours_since)}</span>
                    {" · "}{bySourceTotals.get(s.source) ?? s.fetched ?? 0} jobs
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </section>

      <div class="stat-row">
        <div class="panel stat">
          <div class="k">Jobs ingested</div>
          <div class="stat-n">{stats.totalJobs.toLocaleString()}</div>
          <div class="stat-sub">{newLastRun} new in the last run</div>
        </div>
        <div class="panel stat">
          <div class="k">Scored</div>
          <div class="stat-n">{stats.matches.toLocaleString()}</div>
          <div class="stat-sub">{Math.max(0, stats.totalJobs - stats.matches)} awaiting scoring</div>
        </div>
        <div class="panel stat">
          <div class="k">The catch &ge; 70%</div>
          <div class="stat-n accent">{stats.strong.toLocaleString()}</div>
          <div class="stat-sub">{stats.queue} not yet stashed</div>
        </div>
        <div class="panel stat">
          <div class="k">Applications</div>
          <div class="stat-n">{stats.totalApps.toLocaleString()}</div>
          <div class="stat-sub">{submitted} submitted</div>
        </div>
      </div>

      <div class="two-col">
        <section class="panel">
          <div style="font-size:12px;color:var(--strong);margin-bottom:14px">Applications by status</div>
          {statusRows.map((r) => (
            <div class="status-row">
              <span class="mono status-label">{r.label}</span>
              <span class="status-track"><span class="status-bar" style={`width:${(r.count / maxStatus) * 100}%;background:${STATUS_COLOR[r.label]};opacity:${r.label === "offer" || r.label === "interview" ? 0.9 : 0.45}`}></span></span>
              <span class="mono status-n">{r.count}</span>
            </div>
          ))}
          <div class="rates">
            <div><div class="k">Response</div><div class="mono rate-n">{pct(analytics?.response_rate)}</div></div>
            <div><div class="k">Interview</div><div class="mono rate-n">{pct(analytics?.interview_rate)}</div></div>
            <div><div class="k">Offer</div><div class="mono rate-n" style="color:var(--good)">{pct(analytics?.offer_rate)}</div></div>
          </div>
        </section>

        <section class="panel">
          <div style="display:flex;align-items:baseline;justify-content:space-between">
            <div style="font-size:12px;color:var(--strong)">Applications per day</div>
            <div class="mono faint" style="font-size:11px">30d</div>
          </div>
          <div class="bars">
            {days.map((d) => (
              <span title={`${d.label} · ${d.n}`} style={`flex:1;height:${Math.max(2, (d.n / maxDaily) * 88)}px;background:${d.n === 0 ? "#1a1a1a" : "#2f4b58"};border-radius:2px;display:block`}></span>
            ))}
          </div>
          <div class="bars-axis mono">
            <span>{days[0].label}</span><span>{days[15].label}</span><span>{days[29].label}</span>
          </div>
          <div class="bars-note">{monthTotal} application{monthTotal === 1 ? "" : "s"} in the last 30 days.</div>
        </section>
      </div>
    </>
  )}

  <script is:inline define:vars={{ publicUrl }}>
    // "Pull Jobs" — the manual trigger for the forage that systemd timers and the
    // GitHub Action run on a schedule. POST /ingest is auth-gated and returns 202 with
    // a run_id immediately; the work happens in a FastAPI BackgroundTask, so progress
    // is read from the run ledger rather than from the response.
    const btn = document.getElementById("fetch-now");
    const out = document.getElementById("fetch-status");

    const say = (msg, kind) => {
      out.hidden = false;
      out.textContent = msg;
      out.dataset.kind = kind || "";
    };
    const stop = (msg, kind) => {
      say(msg, kind);
      btn.disabled = false;
      btn.textContent = "Pull Jobs";
    };

    // The forage ends when matching logs its event — that is the last thing
    // _ingest_task does. Ingest events land one per sense as each finishes, so
    // they are the progress signal, not the completion one.
    const POLL_MS = 3000;
    const GIVE_UP_MS = 10 * 60 * 1000;

    async function poll(runId, startedAt) {
      let events = [];
      try {
        const r = await fetch(`${publicUrl}/runs/${encodeURIComponent(runId)}`);
        // 404 just means no event has landed yet — the first sense is still fetching.
        if (r.ok) events = (await r.json()).events || [];
      } catch {
        /* transient — the next tick retries */
      }

      // events_for_run FLATTENS the payload into each event ({kind, created_at,
      // ...payload}) — there is no `.payload` to read through. Keys verified against
      // ingestion/runner.py and matching/engine.py, not remembered (R32).
      const done = events.find((e) => e.kind === "match");
      if (done) {
        stop(`Done — ${done.scored ?? "?"} scored. Reloading…`, "ok");
        location.reload();
        return;
      }

      const ingested = events.filter((e) => e.kind === "ingest");
      const failed = events.filter((e) => e.kind === "error");
      const fetched = ingested.reduce((n, e) => n + (e.fetched || 0), 0);
      const fresh = ingested.reduce((n, e) => n + (e.new || 0), 0);
      const parts = [];
      if (ingested.length) parts.push(`${ingested.length} sense(s) · ${fetched} fetched · ${fresh} new`);
      if (failed.length) parts.push(`${failed.length} failed`);
      say(parts.length ? `Running — ${parts.join(" · ")}` : "Running — contacting senses…");

      if (Date.now() - startedAt > GIVE_UP_MS) {
        stop("Still running after 10 min — reload the page to see where it got to.", "warn");
        return;
      }
      setTimeout(() => poll(runId, startedAt), POLL_MS);
    }

    const start = () => fetch(`${publicUrl}/ingest`, { method: "POST", headers: window.JA.headers() });

    btn?.addEventListener("click", async () => {
      btn.disabled = true;
      btn.textContent = "Starting…";
      say("Requesting a forage…");
      try {
        let r = await start();

        // Unauthorized on the first try is the normal case, not an error: reads need
        // no token, so nothing before this point would have prompted for one. Ask for
        // the password and retry ONCE — a second 401 means the token is genuinely bad.
        if (r.status === 401 || r.status === 403) {
          say("Needs the dashboard password…");
          // Defined by the Layout's body script, which parses after this one. Only
          // ever *called* here (on click), by which time it exists — the guard is for
          // the case where that script failed to load at all.
          if (!window.JA.signIn) { stop(window.JA.explain(r.status), "bad"); return; }
          const signedIn = await window.JA.signIn(
            "Pulling jobs writes to your store, so it needs the dashboard password — " +
            "the same one the Settings page asks for.");
          if (!signedIn) {
            stop("Cancelled — not signed in.", "warn");
            return;
          }
          say("Signed in · requesting a forage…");
          r = await start();
        }

        if (r.status === 409) {
          // The endpoint takes the pipeline lock synchronously, so this is definite,
          // not a guess — another forage (or a timer) already holds it.
          stop("A forage is already running — try again when it finishes.", "warn");
          return;
        }
        if (!r.ok) {
          const d = await r.json().catch(() => null);
          throw new Error((d && typeof d.detail === "string" && d.detail) || window.JA.explain(r.status));
        }
        const { run_id: runId } = await r.json();
        btn.textContent = "Pulling…";
        say(`Started · run ${runId}`);
        poll(runId, Date.now());
      } catch (err) {
        stop(err.message, "bad");
      }
    });
  </script>
</Layout>

<style>
  .fetch-box { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .fetch-status { font-size: 11px; color: var(--muted); max-width: 340px; text-align: right; }
  .fetch-status[data-kind="ok"] { color: var(--good); }
  .fetch-status[data-kind="warn"] { color: var(--warn); }
  .fetch-status[data-kind="bad"] { color: var(--danger); }

  .down { max-width: 520px; margin: 14vh auto; text-align: center; }
  .down-mark {
    width: 44px; height: 44px; margin: 0 auto 18px; border-radius: 50%;
    border: 1px solid rgba(248, 113, 113, 0.35); background: rgba(248, 113, 113, 0.08);
    display: flex; align-items: center; justify-content: center;
    color: var(--danger); font-family: var(--mono); font-size: 18px;
  }
  .down-title { font-size: 19px; color: var(--strong); letter-spacing: -0.01em; }
  .down-body { color: var(--muted); font-size: 13px; line-height: 1.6; margin: 10px 0 22px; }

  .health { margin-bottom: 16px; }
  .health.degraded { border-color: rgba(248, 113, 113, 0.35); background: rgba(248, 113, 113, 0.05); }
  .health-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
  .health-lead { display: flex; gap: 12px; align-items: flex-start; }
  .big-dot { width: 7px; height: 7px; border-radius: 50%; margin-top: 6px; flex: none; display: block; background: var(--good); }
  .big-dot.bad { background: var(--danger); animation: pulsedot 1.6s ease-in-out infinite; }
  .health-title { font-size: 14px; color: var(--strong); letter-spacing: -0.01em; }
  .health-title.bad { color: var(--danger); }
  .health-nums { display: flex; gap: 26px; align-items: flex-start; }
  .src-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px 16px; margin-top: 16px; }
  @media (max-width: 820px) { .src-grid { grid-template-columns: repeat(2, 1fr); } }
  .src-cell { border-top: 1px solid var(--border); padding-top: 9px; }
  .src-dot { width: 5px; height: 5px; border-radius: 50%; display: block; background: var(--good); }
  .src-dot.bad { background: var(--danger); animation: pulsedot 1.6s ease-in-out infinite; }
  .src-meta { font-size: 11px; margin-top: 4px; color: var(--muted); }

  .stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 16px; }
  @media (max-width: 820px) { .stat-row { grid-template-columns: repeat(2, 1fr); } }
  .stat { padding: 14px 16px; }
  .stat-n { font-family: var(--mono); font-size: 24px; color: var(--strong); letter-spacing: -0.02em; margin-top: 6px; }
  .stat-n.accent { color: var(--accent); }
  .stat-sub { font-size: 11.5px; color: var(--muted); margin-top: 2px; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  @media (max-width: 820px) { .two-col { grid-template-columns: 1fr; } }
  .status-row { display: grid; grid-template-columns: 112px 1fr 34px; align-items: center; gap: 10px; margin-bottom: 7px; }
  .status-label { font-size: 11.5px; color: #a3a3a3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .status-track { height: 4px; background: #171717; border-radius: 2px; overflow: hidden; display: block; }
  .status-bar { display: block; height: 100%; border-radius: 2px; }
  .status-n { font-size: 12px; text-align: right; }
  .rates { display: flex; gap: 22px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); }
  .rate-n { font-size: 16px; margin-top: 2px; }
  .bars { display: flex; align-items: flex-end; gap: 3px; height: 92px; margin-top: 18px; }
  .bars-axis { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--faint); margin-top: 8px; }
  .bars-note { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); font-size: 12.5px; color: var(--muted); }
</style>
