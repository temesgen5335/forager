---
// Jobs (design: Job Agent.dc.html). Two zones: "Awaiting your call" — strong matches
// with no decision, the reason this page gets opened — and "Everything else". Every
// row can be dismissed, snoozed, or annotated without leaving the list; decisions
// persist via POST /triage. Filters live in the URL (shareable) and are mirrored to
// localStorage so a bare /jobs visit restores your last view.
import Layout from "../layouts/Layout.astro";
import { getMatches, getSources, getStats, apiBase, publicApiBase,
         type MatchRow, type SourceInfo } from "../lib/api";

const url = Astro.url;
const q = url.searchParams.get("q") ?? "";
// Default to "any", NOT a 7-day window. The queue count in the sidebar and on the
// Overview has no date filter, so a windowed default made a bare /jobs visit show
// fewer rows than the badge promised — with a stale pipeline, zero of them.
const within = url.searchParams.get("within") ?? "any";
const remote = url.searchParams.get("remote") ?? "any";
const exclude = url.searchParams.get("exclude") ?? "";
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1", 10) || 1);
// Repeated `sources=` params (checkbox group) rather than one comma string, so the
// browser builds the query for free on submit.
const pickedSources = url.searchParams.getAll("sources").filter(Boolean);
const minSalary = parseInt(url.searchParams.get("minsal") ?? "0", 10) || 0;
const PAGE = 25;

const days = within === "24h" ? 1 : within === "3d" ? 3 : within === "7d" ? 7 : 0;
const excludeParam = exclude === "US-only" ? "US only" : exclude === "On-site" ? "on-site,onsite" : "";

// Deep enough that the whole stash queue fits: the API no longer caps per company,
// so this is the real ceiling on what the page can show. If the queue ever outgrows
// it, the header below says so rather than silently truncating (R32).
const FETCH = 400;

let rows: MatchRow[] = [];
let sourceInfo: SourceInfo | null = null;
let trueQueue: number | null = null;
let error: string | null = null;
try {
  rows = await getMatches({
    days, location: remote as "any" | "remote" | "hybrid", q,
    exclude: excludeParam, sources: pickedSources.join(","), limit: FETCH, offset: 0,
    minSalary,
  });
  sourceInfo = await getSources();
  // The store's own count of strong ∧ unstashed — the number the sidebar badge shows.
  // Only comparable when nothing is filtering, so that is the only case we compare in.
  trueQueue = (await getStats()).queue;
} catch (e) {
  error = (e as Error).message;
}
// Offer only sources that actually have stored jobs — a checkbox that can never
// match anything is noise.
const storedSources = Object.entries(sourceInfo?.in_store ?? {})
  .sort((a, b) => b[1] - a[1]);

const live = (j: MatchRow) => !j.triage_state;
const queue = rows.filter((j) => j.score >= 0.7 && live(j));
const strongTotal = rows.filter((j) => j.score >= 0.7).length;
const rest = rows.filter((j) => !(j.score >= 0.7 && live(j)));
// A filtered view is legitimately smaller than the store-wide count; an unfiltered
// one is not, so only then does a shortfall mean the fetch ceiling truncated us.
const unfiltered = !q && within === "any" && remote === "any" && !exclude && !pickedSources.length;
const queueShortfall =
  unfiltered && trueQueue !== null && trueQueue > queue.length ? trueQueue - queue.length : 0;
const pages = Math.max(1, Math.ceil(rest.length / PAGE));
const restPage = rest.slice((page - 1) * PAGE, page * PAGE);

const ago = (j: MatchRow) => {
  const ts = j.posted_at ?? (j as any).first_seen_at;
  if (!ts) return "—";
  const h = Math.max(0, (Date.now() - new Date(ts).getTime()) / 36e5);
  return h < 1 ? "<1h ago" : h < 24 ? `${Math.round(h)}h ago` : `${Math.floor(h / 24)}d ago`;
};
const scoreClass = (s: number) => (s >= 0.7 ? "s-hi" : s >= 0.5 ? "s-mid" : "s-lo");
const pctOf = (s: number) => `${Math.round(s * 100)}%`;
// The rationale lists matched skills as "skills: a, b, c" — surface them as chips.
const matchedChips = (j: MatchRow) => {
  const m = /skills: ([^;]+)/.exec(j.rationale ?? "");
  return m ? m[1].split(",").map((x) => x.trim()).slice(0, 4) : [];
};
const gapChips = (j: MatchRow) => (j.gaps ?? []).slice(0, 3);
const remoteTag = (j: MatchRow) =>
  j.is_remote ? "remote" : /hybrid/i.test(j.location ?? "") ? "hybrid" : "on-site";
const metaLine = (j: MatchRow) => `${j.location || "—"} · ${j.source} · ${ago(j)}`;

// Compact pay label. Renders nothing when the pay could not be parsed — a blank is
// honest, whereas "—" next to a number-shaped column reads as "this job pays nothing".
const SYM: Record<string, string> = { USD: "$", EUR: "€", GBP: "£", INR: "₹", NGN: "₦" };
const short = (n: number) => (n >= 1000 ? `${Math.round(n / 1000)}k` : `${Math.round(n)}`);
const payLabel = (j: MatchRow) => {
  if (j.salary_min == null && j.salary_max == null) return "";
  const sym = SYM[j.salary_currency ?? ""] ?? (j.salary_currency ? j.salary_currency + " " : "");
  const lo = j.salary_min, hi = j.salary_max;
  const amount = lo != null && hi != null && lo !== hi
    ? `${sym}${short(lo)}–${short(hi)}`
    : `${sym}${short((hi ?? lo) as number)}`;
  return j.salary_period && j.salary_period !== "year" ? `${amount}/${j.salary_period}` : amount;
};

// How many stored rows share this role across boards. Turning on the aggregator makes
// the same job arrive from LinkedIn, Indeed and its own ATS; this says so instead of
// looking like three separate opportunities.
const clusterCount = new Map<string, number>();
for (const j of rows) {
  if (j.cluster_key) clusterCount.set(j.cluster_key, (clusterCount.get(j.cluster_key) ?? 0) + 1);
}
const alsoOn = (j: MatchRow) => (j.cluster_key ? (clusterCount.get(j.cluster_key) ?? 1) - 1 : 0);

// Filter chips (each individually removable → link without that param).
const linkWith = (patch: Record<string, string>) => {
  const p = new URLSearchParams(url.searchParams);
  for (const [k, v] of Object.entries(patch)) (v ? p.set(k, v) : p.delete(k));
  p.delete("page");
  const qs = p.toString();
  return qs ? `/jobs?${qs}` : "/jobs";
};
const pageLink = (n: number) => {
  const p = new URLSearchParams(url.searchParams);
  p.set("page", String(n));
  return `/jobs?${p.toString()}`;
};
const chips: { label: string; href: string }[] = [];
if (q) chips.push({ label: `“${q}”`, href: linkWith({ q: "" }) });
if (within !== "any") chips.push({ label: `posted < ${within === "24h" ? "24h" : within.replace("d", " days")}`, href: linkWith({ within: "any" }) });
if (remote !== "any") chips.push({ label: remote, href: linkWith({ remote: "any" }) });
if (exclude) chips.push({ label: `exclude ${exclude}`, href: linkWith({ exclude: "" }) });
// Shown with the caveat, because the filter deliberately keeps unknown-pay rows —
// without saying so, a user would read the result as "everything here pays 100k+".
if (minSalary) chips.push({ label: `≥ ${Math.round(minSalary / 1000)}k/yr (or unstated)`,
                            href: linkWith({ minsal: "" }) });
if (pickedSources.length) {
  chips.push({ label: `sources: ${pickedSources.join(", ")}`, href: linkWith({ sources: "" }) });
}

const publicUrl = publicApiBase();
// The exact filter state this page rendered with, handed to the cleanup control so a
// purge deletes the rows you are looking at rather than a second interpretation of them.
const filterState = {
  days, location: remote, q, exclude: excludeParam,
  sources: pickedSources.join(","),
};
const queueData = queue.map((j) => ({
  id: j.id, title: j.title, company: j.company, loc: j.location, score: j.score,
  why: j.rationale, meta: metaLine(j), matched: matchedChips(j), gaps: gapChips(j),
}));
---

<Layout title="Jobs">
  <div class="page-head">
    <div>
      <h1 class="page">Jobs</h1>
      <div class="page-sub">{error ? "" : `${rows.length} match your filters`}</div>
    </div>
    <div style="display:flex;align-items:center;gap:8px">
      <span class="faint" style="font-size:11px">Stash mode</span>
      <div class="mode-toggle">
        <button type="button" class="mode-btn on" data-mode="inline">A · Inline</button>
        <button type="button" class="mode-btn" data-mode="focus">B · One-at-a-time</button>
      </div>
    </div>
  </div>

  {error && (
    <div class="panel">⚠️ Can’t reach the API at <span class="mono">{apiBase()}</span> — {error}</div>
  )}

  {!error && (
    <>
      <form class="panel filters" method="get" action="/jobs" id="filter-form">
        <div class="filter-row">
          <input type="search" name="q" value={q} placeholder="Search title, company, rationale…" />
          <select name="within">
            <option value="24h" selected={within === "24h"}>Posted &lt; 24h</option>
            <option value="3d" selected={within === "3d"}>Posted &lt; 3 days</option>
            <option value="7d" selected={within === "7d"}>Posted &lt; 7 days</option>
            <option value="any" selected={within === "any"}>Any date</option>
          </select>
          <select name="remote">
            <option value="any" selected={remote === "any"}>Anywhere</option>
            <option value="remote" selected={remote === "remote"}>Remote only</option>
            <option value="hybrid" selected={remote === "hybrid"}>Hybrid</option>
          </select>
          <select name="exclude">
            <option value="" selected={exclude === ""}>Exclude…</option>
            <option value="US-only" selected={exclude === "US-only"}>US-only</option>
            <option value="On-site" selected={exclude === "On-site"}>On-site</option>
          </select>
          <select name="minsal">
            <option value="" selected={!minSalary}>Any salary</option>
            <option value="60000" selected={minSalary === 60000}>&ge; 60k / yr</option>
            <option value="100000" selected={minSalary === 100000}>&ge; 100k / yr</option>
            <option value="150000" selected={minSalary === 150000}>&ge; 150k / yr</option>
          </select>
          <button class="btn" type="submit">Apply</button>
        </div>
        {storedSources.length > 1 && (
          <div class="src-row">
            <span class="faint" style="font-size:11px">Sources</span>
            {storedSources.map(([src, n]) => (
              <label class="src-chip">
                <input type="checkbox" name="sources" value={src}
                       checked={pickedSources.includes(src)} />
                <span>{src}</span><span class="src-n mono">{n}</span>
              </label>
            ))}
            <span class="mono faint" style="font-size:11px;margin-left:auto">
              {pickedSources.length ? `${pickedSources.length} selected` : "all shown"}
            </span>
          </div>
        )}
        {chips.length > 0 && (
          <div class="chip-row">
            <span class="faint" style="font-size:11px;letter-spacing:.02em">Active</span>
            {chips.map((c) => (
              <a class="f-chip" href={c.href}>{c.label}<span class="f-x">&times;</span></a>
            ))}
            <a class="linkish" href="/jobs?within=any">Clear all</a>
            <span class="mono faint" style="font-size:11px;margin-left:auto">saved to this browser</span>
          </div>
        )}
      </form>

      <details class="panel cleanup" id="cleanup">
        <summary class="cleanup-head">
          <span>Clean up stored jobs</span>
          <span class="faint" style="font-size:11px;margin-left:auto">
            {rows.length} shown · deletes are previewed first
          </span>
        </summary>

        <p class="cleanup-note">
          Deletes postings from your store. Anything you applied to, tailored a CV for,
          or left a note on is kept whatever you pick here. Postings still live on their
          board come back on the next pull — to stop storing them at all, use the
          ingestion filters in Settings.
        </p>

        <div class="cleanup-row">
          <label class="cl-field">
            <span class="k">What to remove</span>
            <select id="cl-preset">
              <option value="weak">Weak matches — scoring under…</option>
              <option value="dismissed">Everything I dismissed</option>
              <option value="stale">Not seen in a feed for…</option>
              <option value="filters">Everything matching the filters above</option>
            </select>
          </label>

          <label class="cl-field" id="cl-score-wrap">
            <span class="k">Score under</span>
            <select id="cl-score">
              <option value="0.3">30%</option>
              <option value="0.5" selected>50%</option>
              <option value="0.7">70%</option>
            </select>
          </label>

          <label class="cl-field" id="cl-stale-wrap" hidden>
            <span class="k">Last seen over</span>
            <select id="cl-stale">
              <option value="30">30 days ago</option>
              <option value="60" selected>60 days ago</option>
              <option value="90">90 days ago</option>
            </select>
          </label>

          <label class="cl-check">
            <input type="checkbox" id="cl-unscored" />
            <span>also never-matched jobs</span>
          </label>

          <button type="button" class="btn" id="cl-preview">Preview</button>
        </div>

        <div class="cl-result" id="cl-result" hidden></div>
      </details>

      {rows.length === 0 && (
        <div class="panel empty">
          <div style="font-size:15px;color:var(--strong)">Nothing matches</div>
          <p>
            {within !== "any"
              ? "The sources answered, but no posting inside this date window matches your filters."
              : "No stored posting matches these filters."}
          </p>
          {within === "24h" || within === "3d" ? (
            <a class="btn" href={linkWith({ within: "7d" })}>Widen to 7 days</a>
          ) : within === "7d" ? (
            <a class="btn" href={linkWith({ within: "any" })}>Widen to any date</a>
          ) : null}
        </div>
      )}

      <div id="inline-view">
        {queue.length > 0 && (
          <section class="queue">
            <div class="queue-head">
              <span class="q-dot"></span>
              <span style="font-size:12.5px;color:var(--strong);letter-spacing:-.01em">Awaiting your call</span>
              <span class="mono" style="font-size:11.5px;color:var(--accent)">{queue.length}</span>
              <span class="muted" style="font-size:11.5px;margin-left:auto">
                strong matches, unstashed{queueShortfall > 0 ? ` · ${queueShortfall} more beyond this page's ${FETCH}-row fetch` : ""}
              </span>
            </div>
            {queue.map((j) => (
              <div class="q-row trow" data-id={j.id}>
                <div class="t-live">
                  <div class="q-top">
                    <span class:list={["mono", "q-score", scoreClass(j.score)]}>{pctOf(j.score)}</span>
                    <a class="q-title" href={`/jobs/${j.id}`}>{j.title}</a>
                    <span class="muted" style="font-size:13px">{j.company}</span>
                    {payLabel(j) && <span class="pay mono">{payLabel(j)}</span>}
                    {alsoOn(j) > 0 && (
                      <span class="dupe mono" title="the same role is stored from other boards">
                        also on {alsoOn(j)}
                      </span>
                    )}
                    <span class="mono faint" style="font-size:11px;margin-left:auto">{metaLine(j)}</span>
                  </div>
                  <div class="q-why">{j.rationale}</div>
                  <div class="q-chips">
                    {matchedChips(j).map((c) => <span class="chip-ok">{c}</span>)}
                    {gapChips(j).map((g) => <span class="chip-gap">{g}</span>)}
                  </div>
                  <div class="q-actions">
                    <button type="button" class="btn primary sm-pad act-draft" data-id={j.id}>Draft application</button>
                    <a class="btn sm-pad" href={`/jobs/${j.id}`}>Fit check</a>
                    <button type="button" class="btn sm-pad quiet act-snooze" data-id={j.id}>Snooze 3d</button>
                    <button type="button" class="btn sm-pad quiet danger-hover act-dismiss" data-id={j.id}>Dismiss</button>
                  </div>
                </div>
                <div class="t-gone" hidden>
                  <span class="gone-label mono"></span>
                  <span class="gone-title">{j.title} · {j.company}</span>
                  <button type="button" class="linkish act-undo" data-id={j.id} style="margin-left:auto">Undo</button>
                </div>
              </div>
            ))}
          </section>
        )}

        {queue.length === 0 && strongTotal > 0 && rows.length > 0 && (
          <section class="panel cleared">
            <span class="q-dot good"></span>
            <span style="font-size:13px">Queue cleared — every strong match has a decision.</span>
          </section>
        )}

        {rest.length > 0 && (
          <>
            <div class="rest-head">
              <span class="k">Everything else</span>
              <span class="mono faint" style="font-size:11px">{rest.length}</span>
            </div>
            <div class="rest-list">
              {restPage.map((j) => (
                <div class="r-row trow" data-id={j.id} data-state={j.triage_state ?? ""}>
                  <div class="t-live" hidden={!!j.triage_state}>
                    <div class="r-grid">
                      <span class:list={["mono", "r-score", scoreClass(j.score)]}>{pctOf(j.score)}</span>
                      <span style="min-width:0">
                        <span class="r-line1">
                          <a class="r-title" href={`/jobs/${j.id}`}>{j.title}</a>
                          <span class="muted" style="font-size:12.5px">{j.company}</span>
                          <span class="r-tag mono">{remoteTag(j)}</span>
                          {payLabel(j) && <span class="pay mono">{payLabel(j)}</span>}
                          {alsoOn(j) > 0 && <span class="dupe mono">also on {alsoOn(j)}</span>}
                        </span>
                        <span class="r-why">{j.rationale}</span>
                        <span class="r-note mono" hidden={!j.triage_note}>↳ {j.triage_note}</span>
                        <span class="r-noter" hidden>
                          <input class="note-input" value={j.triage_note ?? ""} placeholder="Note to self…" />
                          <button type="button" class="btn primary sm act-savenote" data-id={j.id}>Save</button>
                        </span>
                      </span>
                      <span class="mono r-meta">{metaLine(j)}</span>
                      <span class="r-actions">
                        <button type="button" class="btn sm act-snooze" data-id={j.id}>Snooze</button>
                        <button type="button" class="btn sm act-note" data-id={j.id}>Note</button>
                        <button type="button" class="btn sm danger-hover act-dismiss" data-id={j.id}>Dismiss</button>
                      </span>
                    </div>
                  </div>
                  <div class="t-gone" hidden={!j.triage_state}>
                    <span class="gone-label mono" data-kind={j.triage_state ?? ""}>
                      {j.triage_state === "dismissed" ? "Dismissed" : j.triage_state === "snoozed" ? "Snoozed" : ""}
                    </span>
                    <span class="gone-title">{j.title} · {j.company}</span>
                    <button type="button" class="linkish act-undo" data-id={j.id} style="margin-left:auto">Undo</button>
                  </div>
                </div>
              ))}
            </div>
            <div class="pager">
              <span class="mono faint" style="font-size:11.5px">showing {restPage.length} of {rest.length} · page {page} of {pages}</span>
              <span style="display:flex;gap:6px">
                {page > 1
                  ? <a class="btn sm-pad" href={pageLink(page - 1)}>Previous</a>
                  : <span class="btn sm-pad" style="color:var(--faint);cursor:not-allowed">Previous</span>}
                {page < pages
                  ? <a class="btn sm-pad" href={pageLink(page + 1)}>Next</a>
                  : <span class="btn sm-pad" style="color:var(--faint);cursor:not-allowed">Next</span>}
              </span>
            </div>
          </>
        )}
      </div>

      <div id="focus-view" hidden>
        <div class="focus-progress">
          <span class="mono" style="font-size:11.5px;color:var(--muted)" id="focus-count"></span>
          <span class="focus-track"><span class="focus-bar" id="focus-bar"></span></span>
        </div>
        <section class="panel" id="focus-card" hidden></section>
        <section class="panel empty" id="focus-done" hidden>
          <div style="font-size:15px;color:var(--strong)">Queue cleared</div>
          <p>Every strong match got a decision.</p>
        </section>
        <div class="mono faint" style="font-size:11.5px;margin-top:10px">one decision per card · the list is never shown until the queue is empty</div>
      </div>
    </>
  )}

  <script type="application/json" id="queue-data" set:html={JSON.stringify(queueData)} />

  <script is:inline define:vars={{ publicUrl, filterState }}>
    // ---- filter persistence: the URL is the truth; localStorage restores a bare visit.
    const FKEY = "jobagent.filters";
    const params = new URLSearchParams(location.search);
    if (![...params.keys()].length) {
      try {
        const saved = JSON.parse(localStorage.getItem(FKEY) || "null");
        // "any" is now the default for both `within` and `remote`, so anything else
        // is a real choice worth restoring — including "7d", which used to be the
        // default and was therefore skipped here.
        if (saved && Object.entries(saved).some(([k, v]) =>
              k === "sources" ? (v || []).length : v && v !== "any")) {
          const p = new URLSearchParams();
          for (const [k, v] of Object.entries(saved)) {
            // sources is a repeated param (checkbox group), not a comma string.
            if (k === "sources") (v || []).forEach((x) => p.append("sources", x));
            else if (v) p.set(k, v);
          }
          location.replace("/jobs?" + p.toString());
        }
      } catch {}
    } else {
      try {
        localStorage.setItem(FKEY, JSON.stringify({
          q: params.get("q") || "", within: params.get("within") || "any",
          remote: params.get("remote") || "any", exclude: params.get("exclude") || "",
          minsal: params.get("minsal") || "",
          sources: params.getAll("sources").filter(Boolean),
        }));
      } catch {}
    }

    // ---- triage actions -------------------------------------------------------
    async function triage(id, body) {
      const r = await fetch(`${publicUrl}/triage/${id}`, {
        method: "POST", headers: window.JA.headers(), body: JSON.stringify(body),
      });
      if (!r.ok) throw new Error(window.JA.explain(r.status));
      return r.json();
    }
    const row = (id) => document.querySelector(`.trow[data-id="${CSS.escape(id)}"]`);
    function markGone(el, kind) {
      if (!el) return;
      const live = el.querySelector(".t-live");
      const gone = el.querySelector(".t-gone");
      if (live) live.hidden = true;
      if (gone) {
        gone.hidden = false;
        const label = gone.querySelector(".gone-label");
        if (label) { label.textContent = kind === "dismissed" ? "Dismissed" : "Snoozed 3d"; label.dataset.kind = kind; }
      }
      el.dataset.state = kind;
    }
    function markLive(el) {
      if (!el) return;
      const live = el.querySelector(".t-live");
      const gone = el.querySelector(".t-gone");
      if (live) live.hidden = false;
      if (gone) gone.hidden = true;
      el.dataset.state = "";
    }

    document.addEventListener("click", async (e) => {
      const b = e.target.closest("button");
      if (!b || !b.dataset.id) return;
      const id = b.dataset.id;
      try {
        if (b.classList.contains("act-dismiss")) {
          await triage(id, { action: "dismiss" });
          decided[id] = "dismissed"; markGone(row(id), "dismissed"); refreshFocus();
        } else if (b.classList.contains("act-snooze")) {
          await triage(id, { action: "snooze", days: 3 });
          decided[id] = "snoozed"; markGone(row(id), "snoozed"); refreshFocus();
        } else if (b.classList.contains("act-undo")) {
          await triage(id, { action: "clear" });
          delete decided[id]; markLive(row(id)); refreshFocus();
        } else if (b.classList.contains("act-note")) {
          const el = row(id);
          el.querySelector(".r-noter").hidden = false;
          el.querySelector(".note-input").focus();
        } else if (b.classList.contains("act-savenote")) {
          const el = row(id);
          const note = el.querySelector(".note-input").value;
          await triage(id, { action: "note", note });
          el.querySelector(".r-noter").hidden = true;
          const line = el.querySelector(".r-note");
          line.textContent = note ? "↳ " + note : "";
          line.hidden = !note;
        } else if (b.classList.contains("act-draft")) {
          b.disabled = true; b.textContent = "Drafting…";
          const r = await fetch(`${publicUrl}/apply/prepare`, {
            method: "POST", headers: window.JA.headers(), body: JSON.stringify({ job_id: id }),
          });
          if (!r.ok) {
            const d = await r.json().catch(() => null);
            throw new Error((d && typeof d.detail === "string" && d.detail) || window.JA.explain(r.status));
          }
          // Drafted → the job leaves the queue. Sending still needs your explicit
          // approval (Telegram bot or API) — nothing was submitted here.
          await triage(id, { action: "snooze", days: 3 });
          location.href = "/applications";
        }
      } catch (err) {
        alert(err.message);
        if (b.classList.contains("act-draft")) { b.disabled = false; b.textContent = "Draft application"; }
      }
    });

    // ---- cleanup: preview, then a separate explicit confirm ---------------------
    // The preview and the delete are the SAME request with dry_run flipped, so what
    // gets approved is what goes. Nothing here deletes on one click.
    (function () {
      const $ = (id) => document.getElementById(id);
      const preset = $("cl-preset"), out = $("cl-result");
      if (!preset) return;

      function syncFields() {
        $("cl-score-wrap").hidden = preset.value !== "weak";
        $("cl-stale-wrap").hidden = preset.value !== "stale";
      }
      preset.addEventListener("change", () => { syncFields(); out.hidden = true; });
      syncFields();

      // Filters from the page are ALWAYS sent, so "weak matches" means weak matches
      // within the view you are looking at — never the whole store behind your back.
      function body(dryRun) {
        const b = { dry_run: dryRun, include_unscored: $("cl-unscored").checked,
                    days: filterState.days, location: filterState.location,
                    q: filterState.q, exclude: filterState.exclude,
                    sources: filterState.sources };
        if (preset.value === "weak") b.below_score = parseFloat($("cl-score").value);
        else if (preset.value === "dismissed") b.triage_states = "dismissed";
        else if (preset.value === "stale") b.last_seen_days = parseInt($("cl-stale").value, 10);
        return b;
      }

      const esc = (t) => { const d = document.createElement("span"); d.textContent = t ?? ""; return d.innerHTML; };

      async function call(dryRun) {
        let r = await fetch(`${publicUrl}/jobs/purge`, {
          method: "POST", headers: window.JA.headers(), body: JSON.stringify(body(dryRun)),
        });
        if ((r.status === 401 || r.status === 403) && window.JA.signIn) {
          const ok = await window.JA.signIn(
            "Deleting stored jobs needs the dashboard password — the same one Settings asks for.");
          if (!ok) return null;
          r = await fetch(`${publicUrl}/jobs/purge`, {
            method: "POST", headers: window.JA.headers(), body: JSON.stringify(body(dryRun)),
          });
        }
        if (!r.ok) {
          const d = await r.json().catch(() => null);
          throw new Error((d && typeof d.detail === "string" && d.detail) || window.JA.explain(r.status));
        }
        return r.json();
      }

      $("cl-preview").addEventListener("click", async () => {
        const btn = $("cl-preview");
        btn.disabled = true; btn.textContent = "Checking…";
        try {
          const p = await call(true);
          if (!p) return;
          out.hidden = false;
          if (!p.jobs) {
            out.dataset.kind = "";
            out.innerHTML = `<div class="cl-none">Nothing matches — nothing to delete.` +
              (p.kept_acted_on ? ` ${p.kept_acted_on} matched but are protected.` : "") + `</div>`;
            return;
          }
          out.dataset.kind = "armed";
          // The count is the real total; the list is only a sample of it (R32).
          const list = p.sample.map((j) =>
            `<li><span class="mono cl-s">${j.score == null ? "—" : Math.round(j.score * 100) + "%"}</span> ` +
            `${esc(j.title)} <span class="faint">${esc(j.company || j.source)}</span></li>`).join("");
          out.innerHTML = `
            <div class="cl-count"><strong>${p.jobs.toLocaleString()}</strong> postings will be deleted` +
            (p.kept_acted_on ? `, <strong>${p.kept_acted_on}</strong> protected and kept` : "") + `.</div>
            <ul class="cl-sample">${list}</ul>
            <div class="faint" style="font-size:11px;margin:6px 0 10px">
              showing ${p.sample.length} of ${p.jobs.toLocaleString()} · also removes
              ${p.matches.toLocaleString()} match rows and ${p.triage.toLocaleString()} stash rows
            </div>
            <div class="cl-actions">
              <button type="button" class="btn danger-hover" id="cl-apply">Delete ${p.jobs.toLocaleString()} postings</button>
              <button type="button" class="btn quiet" id="cl-cancel">Cancel</button>
            </div>`;
          $("cl-cancel").addEventListener("click", () => { out.hidden = true; });
          $("cl-apply").addEventListener("click", async () => {
            const go = $("cl-apply");
            go.disabled = true; go.textContent = "Deleting…";
            try {
              const done = await call(false);
              if (!done) { go.disabled = false; go.textContent = "Delete"; return; }
              out.dataset.kind = "ok";
              out.innerHTML = `<div class="cl-count">Deleted ${done.jobs.toLocaleString()} postings. Reloading…</div>`;
              location.reload();
            } catch (e) {
              out.dataset.kind = "bad";
              out.innerHTML = `<div class="cl-count">${esc(e.message)}</div>`;
            }
          });
        } catch (e) {
          out.hidden = false; out.dataset.kind = "bad";
          out.innerHTML = `<div class="cl-count">${esc(e.message)}</div>`;
        } finally {
          btn.disabled = false; btn.textContent = "Preview";
        }
      });
    })();

    // ---- one-at-a-time mode -----------------------------------------------------
    const MKEY = "jobagent.triagemode";
    const queueData = JSON.parse(document.getElementById("queue-data")?.textContent || "[]");
    const decided = {};   // this page-load's decisions, for focus-mode stepping
    const inlineView = document.getElementById("inline-view");
    const focusView = document.getElementById("focus-view");

    function setMode(mode) {
      try { localStorage.setItem(MKEY, mode); } catch {}
      document.querySelectorAll(".mode-btn").forEach((x) => x.classList.toggle("on", x.dataset.mode === mode));
      if (inlineView) inlineView.hidden = mode === "focus";
      if (focusView) focusView.hidden = mode !== "focus";
      if (mode === "focus") refreshFocus();
    }
    document.querySelectorAll(".mode-btn").forEach((x) =>
      x.addEventListener("click", () => setMode(x.dataset.mode)));

    function refreshFocus() {
      if (!focusView || focusView.hidden) return;
      const pending = queueData.filter((j) => !decided[j.id]);
      const total = queueData.length;
      const done = total - pending.length;
      document.getElementById("focus-count").textContent = `${done} of ${total || 1} decided`;
      document.getElementById("focus-bar").style.width = (total ? (done / total) * 100 : 100) + "%";
      const card = document.getElementById("focus-card");
      const doneEl = document.getElementById("focus-done");
      const j = pending[0];
      card.hidden = !j; doneEl.hidden = !!j;
      if (!j) return;
      const esc = (t) => { const d = document.createElement("span"); d.textContent = t ?? ""; return d.innerHTML; };
      card.innerHTML = `
        <div style="display:flex;align-items:flex-start;gap:18px;flex-wrap:wrap">
          <div style="flex:1;min-width:220px">
            <div style="font-size:18px;color:var(--strong);letter-spacing:-.015em">${esc(j.title)}</div>
            <div style="font-size:13.5px;color:var(--muted);margin-top:3px">${esc(j.company)} · ${esc(j.loc || "—")}</div>
            <div class="mono" style="font-size:11.5px;color:var(--faint);margin-top:6px">${esc(j.meta)}</div>
          </div>
          <div style="text-align:right">
            <div class="mono" style="font-size:30px;letter-spacing:-.03em;color:var(--good)">${Math.round(j.score * 100)}%</div>
            <div class="k">match</div>
          </div>
        </div>
        <p style="font-size:13.5px;line-height:1.6;margin:16px 0 0">${esc(j.why)}</p>
        <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:12px">
          ${j.matched.map((c) => `<span class="chip-ok">${esc(c)}</span>`).join("")}
          ${j.gaps.map((g) => `<span class="chip-gap">${esc(g)}</span>`).join("")}
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:22px;padding-top:18px;border-top:1px solid var(--border)">
          <button type="button" class="btn primary act-draft" data-id="${esc(j.id)}" style="padding:9px 18px">Draft application</button>
          <button type="button" class="btn act-snooze" data-id="${esc(j.id)}" style="padding:9px 16px">Snooze 3d</button>
          <button type="button" class="btn quiet danger-hover act-dismiss" data-id="${esc(j.id)}" style="padding:9px 16px">Dismiss</button>
          <a class="linkish" href="/jobs/${esc(j.id)}" style="margin-left:auto;align-self:center;font-size:13px">Full detail</a>
        </div>`;
    }

    setMode(localStorage.getItem(MKEY) === "focus" ? "focus" : "inline");
  </script>
</Layout>

<style>
  .mode-toggle { display: flex; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; background: var(--panel); }
  .mode-btn { border: 0; background: transparent; color: var(--muted); padding: 5px 11px; font-size: 12px; cursor: pointer; font-family: var(--mono); }
  .mode-btn.on { background: var(--hover); color: var(--strong); }

  .filters { padding: 12px 14px; margin-bottom: 16px; }
  .filter-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .filter-row input[type="search"] { flex: 1; min-width: 180px; background: #0d0d0d; border: 1px solid var(--border); border-radius: 8px; padding: 7px 11px; font-size: 13px; color: var(--text); }
  .filter-row select { background: #0d0d0d; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; font-size: 13px; color: var(--text); cursor: pointer; }
  .src-row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border); }
  .src-chip {
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    border: 1px solid var(--border); background: #0d0d0d; border-radius: 999px;
    padding: 3px 10px 3px 8px; font-size: 12px; font-family: var(--mono);
  }
  .src-chip:hover { border-color: #404040; }
  .src-chip:has(input:checked) { border-color: rgba(125,211,252,.4); background: var(--accent-dim); color: var(--accent); }
  .src-chip input { accent-color: var(--accent); margin: 0; }
  .src-n { color: var(--faint); font-size: 10.5px; }
  .chip-row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border); }
  .f-chip {
    display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(125, 211, 252, 0.28);
    background: var(--accent-dim); color: var(--accent); border-radius: 999px;
    padding: 3px 8px 3px 10px; font-size: 11.5px; font-family: var(--mono);
  }
  .f-chip:hover { text-decoration: none; background: rgba(125, 211, 252, 0.2); }
  .f-x { opacity: 0.7; font-size: 13px; line-height: 1; }

  .cleanup { padding: 0; margin-bottom: 16px; }
  .cleanup[open] { padding-bottom: 14px; }
  .cleanup-head {
    display: flex; align-items: center; gap: 10px; padding: 11px 14px;
    cursor: pointer; font-size: 12.5px; color: var(--muted); list-style: none;
  }
  .cleanup-head::-webkit-details-marker { display: none; }
  .cleanup-head::before { content: "›"; transition: transform .15s; display: inline-block; }
  .cleanup[open] .cleanup-head::before { transform: rotate(90deg); }
  .cleanup[open] .cleanup-head { color: var(--strong); border-bottom: 1px solid var(--border); }
  .cleanup-note { font-size: 12px; color: var(--faint); line-height: 1.6; margin: 12px 14px 0; max-width: 70ch; }
  .cleanup-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; padding: 12px 14px 0; }
  .cl-field { display: flex; flex-direction: column; gap: 4px; }
  .cl-field[hidden] { display: none; }
  .cl-field select {
    background: #0d0d0d; border: 1px solid var(--border); border-radius: 8px;
    padding: 7px 9px; font-size: 13px; color: var(--text); cursor: pointer;
  }
  .cl-check { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); padding-bottom: 8px; }
  .cl-check input { accent-color: var(--accent); }
  .cl-result { margin: 12px 14px 0; padding: 12px 14px; border: 1px solid var(--border); border-radius: 10px; background: #0d0d0d; }
  .cl-result[hidden] { display: none; }
  .cl-result[data-kind="armed"] { border-color: rgba(248, 113, 113, 0.35); background: rgba(248, 113, 113, 0.05); }
  .cl-result[data-kind="ok"] { border-color: rgba(74, 222, 128, 0.35); }
  .cl-result[data-kind="bad"] { border-color: rgba(248, 113, 113, 0.45); }
  .cl-count { font-size: 13px; color: var(--text); }
  .cl-none { font-size: 13px; color: var(--muted); }
  .cl-sample { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 3px; }
  .cl-sample li { font-size: 12.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cl-s { color: var(--faint); font-size: 11px; margin-right: 6px; }
  .cl-actions { display: flex; gap: 8px; }

  .pay { font-size: 11px; color: var(--good); border: 1px solid rgba(74,222,128,.28);
         border-radius: 4px; padding: 0 5px; }
  .dupe { font-size: 10.5px; color: var(--faint); border: 1px solid var(--border);
          border-radius: 4px; padding: 0 5px; }

  .empty { padding: 56px 24px; text-align: center; }
  .empty p { color: var(--muted); font-size: 13px; margin: 8px auto 18px; max-width: 380px; }

  .queue {
    border: 1px solid rgba(125, 211, 252, 0.22); border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(125, 211, 252, 0.05), rgba(125, 211, 252, 0) 70%);
    margin-bottom: 22px; overflow: hidden;
  }
  .queue-head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid rgba(125, 211, 252, 0.14); }
  .q-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); display: block; }
  .q-dot.good { background: var(--good); }
  .q-row { padding: 13px 16px; border-bottom: 1px solid rgba(38, 38, 38, 0.7); }
  .q-row:last-child { border-bottom: 0; }
  .q-top { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .q-score { font-size: 17px; letter-spacing: -0.02em; }
  .s-hi { color: var(--good); } .s-mid { color: var(--text); } .s-lo { color: var(--muted); }
  .q-title { font-size: 14.5px; color: var(--strong); letter-spacing: -0.01em; }
  .q-title:hover { color: var(--accent); text-decoration: none; }
  .q-why { font-size: 12.5px; color: var(--muted); margin-top: 5px; }
  .q-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
  .q-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 11px; }
  .sm-pad { padding: 5px 11px; font-size: 12.5px; border-radius: 7px; }
  .t-gone { display: flex; align-items: center; gap: 10px; font-size: 12.5px; color: var(--faint); }
  .t-gone[hidden], .t-live[hidden], .r-noter[hidden], .r-note[hidden] { display: none; }
  .gone-label { font-size: 11px; border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px; color: var(--faint); }
  .gone-label[data-kind="snoozed"] { color: var(--warn); }
  .gone-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .cleared { display: flex; align-items: center; gap: 10px; padding: 18px; margin-bottom: 22px; }
  .rest-head { display: flex; align-items: center; gap: 10px; padding: 0 4px 8px; }
  .rest-list { border-top: 1px solid var(--border); }
  .r-row { padding: 11px 8px; border-bottom: 1px solid var(--border); transition: background 0.12s; }
  .r-row:hover { background: #141414; }
  .r-grid { display: grid; grid-template-columns: 48px 1fr auto; gap: 0 12px; align-items: start; }
  @media (max-width: 820px) { .r-grid { grid-template-columns: 44px 1fr; } }
  .r-score { font-size: 13.5px; padding-top: 1px; }
  .r-line1 { display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; }
  .r-title { font-size: 13.5px; color: var(--text); }
  .r-title:hover { color: var(--accent); text-decoration: none; }
  .r-tag { font-size: 10.5px; color: var(--faint); border: 1px solid var(--border); border-radius: 4px; padding: 0 5px; }
  .r-why { display: block; font-size: 12px; color: var(--faint); margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .r-note { display: block; font-size: 11.5px; color: var(--accent); margin-top: 3px; }
  .r-noter { display: flex; gap: 8px; margin-top: 6px; }
  .note-input { flex: 1; background: #0d0d0d; border: 1px solid var(--border); border-radius: 7px; padding: 5px 10px; font-size: 12.5px; color: var(--text); }
  .r-meta { font-size: 11px; color: var(--faint); white-space: nowrap; padding-top: 2px; }
  @media (max-width: 820px) { .r-meta { display: none; } }
  .r-actions { display: flex; gap: 5px; opacity: 0.22; transition: opacity 0.12s; }
  .r-row:hover .r-actions { opacity: 1; }
  @media (max-width: 820px) { .r-actions { grid-column: 1 / -1; margin-top: 8px; opacity: 1; } }
  .pager { display: flex; align-items: center; justify-content: space-between; padding: 14px 4px; font-size: 12px; color: var(--muted); }

  .focus-progress { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .focus-track { flex: 1; height: 2px; background: #1a1a1a; border-radius: 2px; overflow: hidden; }
  .focus-bar { display: block; height: 100%; width: 0; background: var(--accent); transition: width 0.2s; }
  #focus-card { padding: 22px 24px; }
</style>
