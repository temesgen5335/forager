---
// Sidebar shell (design: Job Agent.dc.html). The nav carries live badges — queue
// count on Jobs, quiet-application count on Applications, a pulsing dot on Overview
// when the pipeline is degraded — so the "do I need to look?" answer is visible from
// any page. Badge data comes from the same API the pages use; a failed fetch just
// hides the badges rather than breaking the page.
import { getStats, getFollowups, publicApiBase, apiBase, type Stats } from "../lib/api";
import AssistantBubble from "../components/AssistantBubble.astro";
import "../styles/assistant.css";

// The sign-in modal fetches from the visitor's browser, so it needs the public base.
const authApiUrl = publicApiBase();

const { title = "Job Agent" } = Astro.props;
const path = Astro.url.pathname;

let stats: Stats | null = null;
let nudgeCount = 0;
try {
  stats = await getStats();
  nudgeCount = (await getFollowups(7)).followups.length;
} catch {
  /* API down — pages render their own unreachable state; nav shows no badges */
}
const queueCount = stats?.queue ?? 0;
// Version comes from the API's /health, which reads jobagent.__version__ — the
// dashboard never carries its own copy, so the two can never disagree.
let apiVersion: string | null = null;
try {
  apiVersion = (await (await fetch(`${apiBase()}/health`)).json()).version ?? null;
  // /health stays open even when reads are gated — it is a liveness probe (the Docker
  // HEALTHCHECK calls it) and reveals nothing about the job search.
} catch { /* API down — the page already renders its own unreachable state */ }
const degraded =
  !!stats?.health &&
  (stats.health.is_stale ||
    stats.health.recent_errors > 0 ||
    stats.health.sources.some((s) => (s.hours_since ?? 0) > 48));

const nav = [
  { href: "/", label: "Overview", key: "overview" },
  { href: "/jobs", label: "Jobs", key: "jobs" },
  { href: "/applications", label: "Applications", key: "applications" },
  { href: "/assistant", label: "Baer", key: "assistant" },
  { href: "/settings", label: "Settings", key: "settings" },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Job Agent</title>
    <!--
      Shared client-side auth for dashboard actions (stash, fit check, status edits,
      follow-up drafts). Every API write needs the bearer token minted by the Settings
      login. `is:inline` keeps this un-bundled so it runs before page scripts.
    -->
    <script is:inline>
      window.JA = {
        token: () => localStorage.getItem("jobagent_token"),
        headers() {
          const t = this.token();
          const h = { "Content-Type": "application/json" };
          if (t) h.Authorization = `Bearer ${t}`;
          return h;
        },
        explain(status) {
          return status === 401 || status === 403
            ? "Not signed in — open Settings, sign in, then retry."
            : `HTTP ${status}`;
        },
      };
    </script>
  </head>
  <body>
    <div class="shell">
      <nav class="side">
        <div class="brand">
          <span class:list={["brand-dot", degraded && "bad"]}></span>
          <span class="brand-name">job&#8202;agent</span>
        </div>
        <div class="side-nav">
          {nav.map((n) => (
            <a href={n.href} class:list={["side-link", isActive(n.href) && "on"]}>
              <span>{n.label}</span>
              {n.key === "overview" && degraded && <span class="health-dot"></span>}
              {n.key === "jobs" && queueCount > 0 && (
                <span class="queue-badge">{queueCount}</span>
              )}
              {n.key === "applications" && nudgeCount > 0 && (
                <span class="nudge-badge">{nudgeCount}</span>
              )}
            </a>
          ))}
        </div>
        {apiVersion && <div class="side-version mono">v{apiVersion}</div>}
      </nav>
      <main class="content"><slot /></main>
    </div>

    <AssistantBubble />

    <!--
      Sign-in prompt for any page whose write hit a 401/403. Lives here rather than on
      a page because every write surface (pull jobs, stash, fit check, status edits,
      follow-up drafts) hits the same wall, and because the token it mints is the same
      `jobagent_token` the Settings page writes — one session, not two. Settings keeps
      its own inline gate: there the lock IS the page, here it is an interruption.
    -->
    <div id="ja-auth" class="ja-auth" hidden>
      <div class="ja-auth-card" role="dialog" aria-modal="true" aria-labelledby="ja-auth-title">
        <div id="ja-auth-title" class="ja-auth-title">Sign in to continue</div>
        <p class="ja-auth-body" id="ja-auth-why">
          This action changes data on the agent, so it needs the dashboard password —
          the same one the Settings page asks for.
        </p>
        <form id="ja-auth-form" class="ja-auth-form">
          <input type="password" id="ja-auth-pw" placeholder="Dashboard password"
                 autocomplete="current-password" />
          <button type="submit" class="btn primary" id="ja-auth-go">Sign in</button>
          <button type="button" class="btn quiet" id="ja-auth-cancel">Cancel</button>
        </form>
        <div class="ja-auth-msg" id="ja-auth-msg"></div>
      </div>
    </div>

    <script is:inline define:vars={{ authApiUrl }}>
      // Extends the window.JA defined in <head>. Kept separate from that block because
      // this half needs the DOM; the headers()/explain() half must run before any page
      // script, so it cannot wait for it.
      (function () {
        const el = (id) => document.getElementById(id);
        const modal = el("ja-auth");
        let pending = null;      // resolve fn of the in-flight signIn() promise

        function close(result) {
          modal.hidden = true;
          el("ja-auth-pw").value = "";
          el("ja-auth-msg").textContent = "";
          const done = pending;
          pending = null;
          if (done) done(result);
        }

        /**
         * Prompt for the dashboard password. Resolves true once a token is stored,
         * false if the user cancels. Concurrent callers share one prompt rather than
         * stacking modals.
         */
        window.JA.signIn = function signIn(why) {
          if (why) el("ja-auth-why").textContent = why;
          if (pending) return new Promise((r) => { const prev = pending; pending = (v) => { prev(v); r(v); }; });
          modal.hidden = false;
          setTimeout(() => el("ja-auth-pw").focus(), 0);
          return new Promise((resolve) => { pending = resolve; });
        };

        el("ja-auth-form").addEventListener("submit", async (e) => {
          e.preventDefault();
          const msg = el("ja-auth-msg");
          const go = el("ja-auth-go");
          go.disabled = true;
          msg.dataset.kind = "";
          msg.textContent = "Checking…";
          try {
            const r = await fetch(`${authApiUrl}/auth/login`, {
              method: "POST", headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ password: el("ja-auth-pw").value }),
            });
            if (!r.ok) {
              msg.dataset.kind = "bad";
              // 403 is not a wrong password — it means the API has no password set at
              // all, so no amount of retrying here will help. Say which it is.
              msg.textContent = r.status === 401 ? "Wrong password."
                : r.status === 403 ? "Editing is disabled on the API — set DASHBOARD_PASSWORD and restart it."
                : `Sign-in failed (HTTP ${r.status}).`;
              return;
            }
            // Same key the Settings page writes, so signing in here unlocks there too.
            localStorage.setItem("jobagent_token", (await r.json()).token);
            close(true);
          } catch (err) {
            msg.dataset.kind = "bad";
            msg.textContent = `Can't reach the API at ${authApiUrl} — ${err.message}`;
          } finally {
            go.disabled = false;
          }
        });

        el("ja-auth-cancel").addEventListener("click", () => close(false));
        modal.addEventListener("click", (e) => { if (e.target === modal) close(false); });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !modal.hidden) close(false);
        });
      })();
    </script>

    <style is:global>
      :root {
        /* Neutral dark palette with a sky accent. */
        --bg: #0a0a0a;
        --panel: #111111;
        --hover: #1c1c1c;
        --border: #262626;
        --text: #e5e5e5;
        --strong: #fafafa;
        --muted: #737373;
        --faint: #585858;
        --accent: #7dd3fc;
        --accent-dim: rgba(125, 211, 252, 0.13);
        --good: #4ade80;
        --warn: #fbbf24;
        --danger: #f87171;
        --info: #60a5fa;
        --radius: 12px;
        --radius-sm: 8px;
        --font: ui-sans-serif, -apple-system, "Segoe UI", Roboto, Inter, system-ui, sans-serif;
        --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
      }
      * { box-sizing: border-box; }
      html { color-scheme: dark; }
      html, body { margin: 0; padding: 0; background: var(--bg); }
      body { font: 14px/1.45 var(--font); color: var(--text); -webkit-font-smoothing: antialiased; }
      button, input, select, textarea { font: inherit; color: inherit; }
      ::selection { background: rgba(125, 211, 252, 0.25); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 8px; }
      ::-webkit-scrollbar-track { background: transparent; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes pulsedot { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }

      /* ---- shell ------------------------------------------------------------- */
      .shell { display: flex; flex-wrap: wrap; align-items: stretch; min-height: 100vh; }
      .side {
        width: 196px; flex: none; border-right: 1px solid var(--border);
        padding: 20px 8px; display: flex; flex-direction: column; gap: 4px;
        position: sticky; top: 0; align-self: flex-start; height: 100vh;
      }
      .brand { display: flex; align-items: center; gap: 8px; padding: 0 12px 18px; }
      .brand-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--good); display: block; }
      .brand-dot.bad { background: var(--danger); }
      .brand-name { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; color: var(--strong); }
      .side-nav { display: flex; flex-direction: column; gap: 2px; }
      .side-link {
        display: flex; align-items: center; gap: 8px; width: 100%;
        border-radius: 8px; padding: 7px 12px; font-size: 13.5px;
        color: var(--muted); white-space: nowrap;
      }
      .side-link:hover { background: var(--hover); color: var(--text); text-decoration: none; }
      .side-link.on { background: var(--hover); color: var(--strong); }
      .health-dot {
        width: 5px; height: 5px; border-radius: 50%; background: var(--danger);
        display: block; margin-left: auto; animation: pulsedot 1.6s ease-in-out infinite;
      }
      .queue-badge {
        margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--accent);
        background: var(--accent-dim); border-radius: 999px; padding: 0 6px;
      }
      .nudge-badge { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--warn); }
      .content { flex: 1; min-width: 0; padding: 28px 34px 64px; max-width: 1180px; }
      @media (max-width: 820px) {
        .side { width: 100%; height: auto; position: static; border-right: 0; border-bottom: 1px solid var(--border); }
        .side-nav { flex-direction: row; overflow-x: auto; }
        .content { padding: 20px 16px 48px; }
      }

      /* ---- shared primitives --------------------------------------------------- */
      h1.page { margin: 0; font-size: 21px; font-weight: 600; letter-spacing: -0.02em; color: var(--strong); }
      .page-sub { color: var(--muted); font-size: 13px; margin-top: 3px; }
      .page-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
      .panel { border: 1px solid var(--border); background: var(--panel); border-radius: var(--radius); padding: 16px 18px; }
      .k { font-size: 10px; letter-spacing: 0.09em; text-transform: uppercase; color: var(--faint); }
      .mono { font-family: var(--mono); }
      .muted { color: var(--muted); }
      .faint { color: var(--faint); }

      .btn {
        border: 1px solid var(--border); background: transparent; color: var(--text);
        border-radius: var(--radius-sm); padding: 7px 13px; font-size: 13px; cursor: pointer;
      }
      .btn:hover { background: var(--hover); }
      .btn.primary { border-color: rgba(125, 211, 252, 0.4); background: var(--accent-dim); color: var(--accent); }
      .btn.primary:hover { background: rgba(125, 211, 252, 0.2); }
      .btn.quiet { color: var(--muted); }
      .btn.quiet:hover { color: var(--text); }
      .btn.danger-hover:hover { background: rgba(248, 113, 113, 0.1); color: var(--danger); border-color: rgba(248, 113, 113, 0.3); }
      .btn.sm { padding: 3px 8px; font-size: 11.5px; border-radius: 6px; color: var(--muted); background: var(--panel); }
      .btn.sm:hover { color: var(--text); background: var(--hover); }
      .btn.sm.danger-hover:hover { color: var(--danger); background: rgba(248, 113, 113, 0.08); border-color: rgba(248, 113, 113, 0.3); }
      .btn:disabled { opacity: 0.55; cursor: default; }

      .side-version { margin-top: auto; padding: 12px 4px 4px; font-size: 10.5px; color: var(--faint); }

      /* Sign-in prompt (window.JA.signIn) */
      .ja-auth[hidden] { display: none; }
      .ja-auth {
        position: fixed; inset: 0; z-index: 60; display: flex;
        align-items: center; justify-content: center; padding: 20px;
        background: rgba(0, 0, 0, 0.62);
      }
      .ja-auth-card {
        width: 100%; max-width: 400px; background: var(--panel);
        border: 1px solid var(--border); border-radius: var(--radius); padding: 22px 22px 18px;
      }
      .ja-auth-title { font-size: 16px; color: var(--strong); letter-spacing: -0.01em; }
      .ja-auth-body { font-size: 12.5px; color: var(--muted); line-height: 1.6; margin: 8px 0 16px; }
      .ja-auth-form { display: flex; gap: 8px; flex-wrap: wrap; }
      .ja-auth-form input {
        flex: 1; min-width: 150px; background: #0d0d0d; border: 1px solid var(--border);
        border-radius: 8px; padding: 8px 11px; font-size: 13px; color: var(--text);
      }
      .ja-auth-form input:focus { outline: none; border-color: rgba(125, 211, 252, 0.45); }
      .ja-auth-form .btn { padding: 8px 14px; }
      .ja-auth-msg { font-size: 12px; color: var(--muted); margin-top: 10px; min-height: 1em; }
      .ja-auth-msg[data-kind="bad"] { color: var(--danger); }
      .linkish {
        border: 0; background: transparent; color: var(--muted); font-size: 12px; cursor: pointer;
        text-decoration: underline; text-underline-offset: 3px; padding: 0;
      }
      .linkish:hover { color: var(--text); }

      .chip-ok {
        border: 1px solid rgba(74, 222, 128, 0.22); background: rgba(74, 222, 128, 0.07);
        color: #86efac; border-radius: 5px; padding: 2px 7px; font-size: 11.5px; font-family: var(--mono);
      }
      .chip-gap {
        border: 1px solid var(--border); color: var(--muted);
        border-radius: 5px; padding: 2px 7px; font-size: 11.5px; font-family: var(--mono);
      }
      .set-badge {
        border: 1px solid rgba(74, 222, 128, 0.25); background: rgba(74, 222, 128, 0.07);
        color: #86efac; border-radius: 4px; padding: 1px 6px; font-size: 10.5px; font-family: var(--mono);
      }
      .set-badge.no { border-color: rgba(248, 113, 113, 0.28); background: rgba(248, 113, 113, 0.07); color: var(--danger); }

      .field input, .field select {
        width: 100%; background: #0d0d0d; border: 1px solid var(--border);
        border-radius: var(--radius-sm); padding: 7px 10px; font-size: 13px; color: var(--text);
      }
      .field > span { display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: var(--muted); margin-bottom: 5px; }
      .spinner {
        width: 13px; height: 13px; border: 1.5px solid var(--border); border-top-color: var(--accent);
        border-radius: 50%; display: inline-block; animation: spin 0.8s linear infinite;
      }
    </style>
  </body>
</html>
